# Configure real values in Vercel. Never commit credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=荷包 <noreply@hebaogj.xyz>
PUBLIC_SITE_ORIGIN=https://hebaogj.xyz
ADMIN_NOTIFY_EMAIL=
GEMINI_API_KEY=
GEMINI_DAILY_LIMIT=300
# Listing photos. Bucket must be "name-APPID" (e.g. hebao-1250000000); region e.g. eu-frankfurt.
# Check config any time: GET https://hebaogj.xyz/api/delft-upload?check=1
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# auto (default): COS first, fall back to Turso if COS fails | cos: COS only | db: Turso only
IMAGE_STORAGE=auto
