{
  "functions": {
    "api/share-page.js": {
      "includeFiles": "delft/{index.html,events-feed.json,city-events.js,site-config.js}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=(), microphone=(self)" }
      ]
    },
    {
      "source": "/delft/a2-audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/delft/(.*)\\.(webp|png|jpg|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/share-page?__path=/" },
    { "source": "/events", "destination": "/api/share-page?__path=/events" },
    { "source": "/events/", "destination": "/api/share-page?__path=/events" },
    { "source": "/market", "destination": "/api/share-page?__path=/market" },
    { "source": "/market/", "destination": "/api/share-page?__path=/market" },
    { "source": "/dutch-a2", "destination": "/api/share-page?__path=/dutch-a2" },
    { "source": "/dutch-a2/", "destination": "/api/share-page?__path=/dutch-a2" },
    { "source": "/dutch", "destination": "/api/share-page?__path=/dutch" },
    { "source": "/dutch/", "destination": "/api/share-page?__path=/dutch" },
    { "source": "/news", "destination": "/api/share-page?__path=/news" },
    { "source": "/news/", "destination": "/api/share-page?__path=/news" },
    { "source": "/mine", "destination": "/api/share-page?__path=/mine" },
    { "source": "/mine/", "destination": "/api/share-page?__path=/mine" },
    { "source": "/sell", "destination": "/api/share-page?__path=/sell" },
    { "source": "/sell/", "destination": "/api/share-page?__path=/sell" },
    { "source": "/privacy", "destination": "/api/share-page?__path=/privacy" },
    { "source": "/privacy/", "destination": "/api/share-page?__path=/privacy" },
    { "source": "/terms", "destination": "/api/share-page?__path=/terms" },
    { "source": "/terms/", "destination": "/api/share-page?__path=/terms" }
  ],
  "crons": [
    {
      "path": "/api/daily-news-cron",
      "schedule": "0 6 * * *"
    }
  ]
}
